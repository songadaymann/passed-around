{
  "name": "passed-around",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "node --check worker/index.mjs && node --check worker/music.mjs && node --check public/app.js",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "build:mac": "bash scripts/build-mac.sh"
  },
  "devDependencies": {
    "miniflare": "5.20261118.0-beta",
    "wrangler": "4.165.0"
  }
}
